# Run SETUP_WINDOWS.cmd to create a local .env with unique credentials.
# Never commit or share your actual .env.
APP_ENV=local
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:8000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mednova
MYSQL_USER=mednova_app
MYSQL_PASSWORD=
MYSQL_SSL_CA=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
TURN_URL=
TURN_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLAMAV_COMMAND=
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY=0

# Absolute private persistent volume path in production (never served directly).
PRIVATE_MEDIA_ROOT=

# Durable private reports: required on Vercel. Keep the bucket private.
PRIVATE_STORAGE_BACKEND=filesystem
S3_BUCKET_NAME=
S3_REGION_NAME=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Vercel Cron sends Authorization: Bearer CRON_SECRET.
CRON_SECRET=

# Optional local development label. Does not create fixture data or select SQLite.
MEDNOVA_DEMO=0
# One-time administrator runner only; remove after provisioning.
MEDNOVA_ADMIN_EMAIL=
MEDNOVA_ADMIN_PASSWORD=

# Explicit PostgreSQL opt-in; MySQL remains the current local runtime.
DATABASE_VENDOR=mysql
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSCHEMA=mednova
PGSSLMODE=verify-full
PGSSLROOTCERT=

# Vercel deployment/vercel project only; no secret and no localhost in production.
# Set this to the verified HTTPS Render backend origin after it is healthy.
MEDNOVA_BACKEND_ORIGIN=
