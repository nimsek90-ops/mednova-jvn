# Run SETUP_WINDOWS.cmd to create a local .env with unique credentials.
# Never commit or share your actual .env.
APP_ENV=local
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:8000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mednova
MYSQL_USER=mednova_app
MYSQL_PASSWORD=
MYSQL_SSL_CA=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
TURN_URL=
TURN_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLAMAV_COMMAND=
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY=0

# Absolute private persistent volume path in production (never served directly).
PRIVATE_MEDIA_ROOT=
